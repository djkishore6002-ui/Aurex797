# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite file path; for PostgreSQL use postgres:// URL)
DATABASE_URL=./storage/aurex.db

# Storage
STORAGE_DIR=./storage/uploads
PUBLIC_STORAGE_URL=/uploads

# AI
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=mock
AI_PLATFORM_MODEL=openrouter/auto
AI_DAILY_LIMIT_PER_USER=50

# App
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
