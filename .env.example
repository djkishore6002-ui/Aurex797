# ─────────────────────────────────────────────────────────────
# SOLAI — environment variables (EXAMPLE — copy to .env)
# ─────────────────────────────────────────────────────────────
# NEVER commit real secrets to Git.

# SQLite database file (embedded, zero-config). For Postgres in production,
# see README → "Switching to PostgreSQL".
DATABASE_PATH=./data/solai.db

# Secret used to sign sessions and encrypt BYOAI API keys (generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployment (used for QR codes / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Platform AI (OpenRouter) ─────────────────────────────────
# Server-side only. NEVER exposed to the browser.
# If unset, the AI tutor falls back to the built-in local
# retrieval engine (answers strictly from platform content).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_STRONG_MODEL=

# ── Object storage (optional, production) ────────────────────
# Uploads default to local ./data/uploads which is served through
# an authorized API route. Point STORAGE_URL at Supabase Storage /
# S3-compatible storage in production if desired.
STORAGE_URL=

# ── Vector database (optional, production upgrade path) ──────
# The built-in retrieval engine is BM25 keyword search over the
# ai_knowledge_chunks table. VECTOR_DATABASE_URL is reserved for a
# pgvector / external vector store upgrade.
VECTOR_DATABASE_URL=
